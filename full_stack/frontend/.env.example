# Frontend Configuration for JobDataCamp

# PRODUCTION CONFIGURATION (Default - Render.com deployment)
REACT_APP_BACKEND_URL=https://python-job-scraper.onrender.com
REACT_APP_ENVIRONMENT=production

# API timeout
REACT_APP_API_TIMEOUT=120000

# DEVELOPMENT CONFIGURATION (Uncomment for local development)
# REACT_APP_BACKEND_URL=http://localhost:5000
# REACT_APP_ENVIRONMENT=development

# Instructions:
# 1. Copy this file to .env
# 2. Update REACT_APP_BACKEND_URL if your backend runs on a different port
# 3. Adjust API_TIMEOUT if needed (default: 2 minutes)