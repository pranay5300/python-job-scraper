# LinkedIn Credentials
LINKEDIN_EMAIL=your-linkedin-email@example.com
LINKEDIN_PASSWORD=your-linkedin-password
LINKEDIN_PHONE=+1-555-123-4567

# Simplify Platform (optional)
SIMPLIFY_API_KEY=your-simplify-api-key
SIMPLIFY_USER_TOKEN=your-simplify-token
SIMPLIFY_EMAIL=your-simplify-email@example.com
SIMPLIFY_PASSWORD=your-simplify-password

# Email Configuration
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-gmail-app-password
RECIPIENT_EMAIL=your-recipient@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Google Sheets Integration
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project",...}
GOOGLE_SHEET_SHARE_EMAIL=your-email@gmail.com

# Safety Settings
MAX_APPLICATIONS_PER_DAY=25
MAX_APPLICATIONS_PER_HOUR=5
MAX_APPLICATIONS_PER_COMPANY=2
MIN_DELAY_BETWEEN_APPLICATIONS=45
MAX_DELAY_BETWEEN_APPLICATIONS=120

# Browser Settings
HEADLESS=false
CHROME_BIN=/usr/bin/google-chrome
CHROMEDRIVER_PATH=/usr/bin/chromedriver

# System Settings
LOG_LEVEL=INFO
RESUME_DIRECTORY=resumes
BACKUP_ENABLED=true