# Email Configuration
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
RECIPIENT_EMAIL=recipient@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Google Sheets Configuration
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id",...}
GOOGLE_SHEET_SHARE_EMAIL=your-email@gmail.com
SPREADSHEET_NAME=MBA_Jobs_Daily_Feed

# Scraping Configuration
RUN_ONCE=false
DAILY_RUN_TIME=08:00
MAX_JOBS_PER_COMPANY=5
REQUEST_DELAY=2.0

# Chrome Driver Configuration (for Render.com)
CHROME_BIN=/usr/bin/google-chrome
CHROMEDRIVER_PATH=/usr/bin/chromedriver